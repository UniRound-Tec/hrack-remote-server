# HRack 平台反代示例（配合 deploy/docker-compose.yml 的 nginx 服务）。
# 分流规则（PAIRING-PLATFORM-SPEC §4）：
#   /          → web（Next.js）
#   /remote、/remote/ → dashboard
#   /remote/{roomId} → relay（含 WebSocket 升级 /remote/v1/ws）
#   /api/auth/*、/api/admin/*、/dashboard、/admin 关闭 access_log

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 直接终止 TLS 时没有上游转发头，回退到当前连接信息。
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_x_real_ip $forwarded_real_ip {
    default $http_x_real_ip;
    ''      $remote_addr;
}

server {
    listen 80;
    server_name _;
    # 证书就绪后重定向到 https；本地调试可注释
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hrack.example;
    absolute_redirect off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 路由与敏感路径日志策略由生产/本地门禁共用，避免两份配置漂移。
    include /etc/nginx/hrack.routes.conf;
}
