# HRack 平台反代示例（配合 deploy/docker-compose.yml 的 nginx 服务）。
# 分流规则（PAIRING-PLATFORM-SPEC §4）：
#   /          → web（Next.js）
#   /remote、/remote/ → dashboard
#   /remote/{roomId} → relay（含 WebSocket 升级 /remote/v1/ws）
#   独立 dsh.hrack.example origin → relay DSH Gateway（HTTP/SSE/WS）
#   /api/auth/*、/api/admin/*、/dashboard、/admin 关闭 access_log

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 直接终止 TLS 时没有上游转发头，回退到当前连接信息。
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_x_real_ip $forwarded_real_ip {
    default $http_x_real_ip;
    ''      $remote_addr;
}

server {
    listen 80;
    server_name _;

    # ACME webroot 续期必须保持 HTTP 可达，其余请求再跳转 HTTPS。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name hrack.example;
    absolute_redirect off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 路由与敏感路径日志策略由生产/本地门禁共用，避免两份配置漂移。
    include /etc/nginx/hrack.routes.conf;
}

# 必须使用独立 origin；证书需要同时覆盖该域名，或换成独立证书路径。
server {
    listen 443 ssl;
    http2 on;
    server_name dsh.hrack.example;
    absolute_redirect off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    include /etc/nginx/hrack.dsh.routes.conf;
}
