# HRack 平台反代示例（配合 deploy/docker-compose.yml 的 nginx 服务）。
# 分流规则（PAIRING-PLATFORM-SPEC §4）：
#   /          → web（Next.js）
#   /remote、/remote/ → dashboard
#   /remote/{roomId} → relay（含 WebSocket 升级 /remote/v1/ws）
#   /api/auth/*、/api/admin/*、/dashboard、/admin 关闭 access_log

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    # 证书就绪后重定向到 https；本地调试可注释
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hrack.example;
    absolute_redirect off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # —— 平台站（Next.js） ——
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 认证、管理接口与会话页不落访问日志，避免邮箱和 setup 路径进入访问日志。
    location ^~ /api/auth/ {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /api/admin/ {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /dashboard {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ^~ /dashboard/ {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /admin {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 尾斜杠避免误匹配 /administrator。
    location ^~ /admin/ {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # —— 配对入口与内部边界 ——
    location = /remote {
        return 307 /dashboard;
    }

    location = /remote/ {
        return 307 /dashboard;
    }

    # 系统同步接口只允许 Docker 内网直连 Relay。
    location = /remote/v1/system {
        return 404;
    }

    location ^~ /remote/v1/system/ {
        return 404;
    }

    # 生产环境不暴露调试 demo。
    location = /remote/demo {
        return 404;
    }

    location ^~ /remote/demo/ {
        return 404;
    }

    # 公开配对页、探活、房间 API 与 WebSocket 继续转发 Relay。
    location /remote/ {
        proxy_pass http://relay:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
