# HRack 平台反代示例（配合 deploy/docker-compose.yml 的 nginx 服务）。
# 分流规则（PAIRING-PLATFORM-SPEC §4）：
#   /          → web（Next.js）
#   /remote/   → relay（含 WebSocket 升级 /remote/v1/ws）
#   /api/auth/*、/dashboard 关闭 access_log（邮箱等不落访问日志，spec §7.2）

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    # 证书就绪后重定向到 https；本地调试可注释
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hrack.example;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # —— 平台站（Next.js） ——
    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 认证接口与会话页不落访问日志
    location ~ ^/(api/auth/|dashboard) {
        access_log off;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # —— 中继（协议转发 + WebSocket） ——
    location /remote/ {
        proxy_pass http://relay:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
