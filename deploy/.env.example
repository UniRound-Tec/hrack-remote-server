# deploy/.env.example — 拷贝为 .env 后填写；.env 不入库
# 固定项目名，便于备份、恢复和运维命令稳定引用 hrack_web-data。
COMPOSE_PROJECT_NAME=hrack

# 对外源（决定 joinUrl 与回跳域名）
PUBLIC_ORIGIN=https://hrack.example
# DSH 官方 Web UI 必须使用另一正式 TLS origin；留空关闭 DSH Web Tunnel。
DSH_PUBLIC_ORIGIN=https://dsh.hrack.example
# 已有 1Panel/OpenResty/Caddy 终止 TLS 时，host-edge 只绑定此 loopback 端口。
HOST_EDGE_PORT=8788
# 同一外层反代把 DSH_PUBLIC_ORIGIN 转到这个独立 loopback 端口，并保留 Host/Upgrade。
DSH_HOST_EDGE_PORT=8789

# 中继服务凭证（≥32 字节随机，web、协调器与 relay 同值）：openssl rand -hex 32
RELAY_SERVICE_TOKEN=
# 配对协调器校准周期（1000..60000 ms，默认 5000）
PAIRING_RECONCILE_INTERVAL_MS=5000

# 生产健康监控：连续失败达到阈值才告警，恢复后发一次恢复通知。
MONITOR_INTERVAL_MS=30000
MONITOR_FAILURE_THRESHOLD=3
MONITOR_TLS_MIN_DAYS=14
# 至少配置 webhook 或“告警邮箱 + Resend”之一；自部署可留空并只看 JSON 日志。
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_EMAIL_TO=
# Docker json-file 日志轮转上限。
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Web 会话签名（openssl rand -hex 32）
BETTER_AUTH_SECRET=

# revokeToken 落盘加密密钥（32 字节 base64）
PAIRING_ENC_KEY=
# 可选：单独加密 SMTP/OAuth 设置；留空时复用 PAIRING_ENC_KEY。
# 未单独设置时，轮换 PAIRING_ENC_KEY 会同时令配对 URL 与已存 SMTP/OAuth 密文失效。
SETTINGS_ENC_KEY=

# 可选：额外可信浏览器源，逗号分隔（例如 www/apex 双域）；非 GET Admin API 会校验。
BETTER_AUTH_TRUSTED_ORIGINS=

# —— 以下可选 ——
# GitHub / Google OAuth。回调地址固定为：
#   ${PUBLIC_ORIGIN}/api/auth/callback/github
#   ${PUBLIC_ORIGIN}/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮件。非空环境变量会钉死后台对应字段；MAIL_PROVIDER 会钉死 provider 种类。
# 生产环境未配置 provider 时邮件不可用；console 在生产不会输出验证码。
MAIL_PROVIDER=
# Resend：API key 必填；SMTP_FROM 可覆盖 sandbox 发件人，生产请填写已验证域名。
RESEND_API_KEY=
# SMTP：host/port/from/security 必填；user/pass 要么同时填写，要么同时留空。
# security: tls（通常 465）| starttls（通常 587）| none（仅本地测试）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURITY=
# true/1 开启邮箱验证；false/0 或留空则注册及 OAuth 后直接登录。
# 开启后同时约束密码与 GitHub/Google，并要求先把邮件 provider 测通。
EMAIL_VERIFICATION_REQUIRED=
# 首位管理员的无邮件网页逃生入口；至少 24 字节随机值，创建首位管理员后删除。
# 生成示例：openssl rand -hex 32
ADMIN_SETUP_TOKEN=
# 可选：此邮箱正常完成 OTP/OAuth 注册后自动成为首位管理员；它不会绕过邮件验证。
ADMIN_BOOTSTRAP_EMAIL=
# 中继生成页匿名创建调试开关（生产留空）
ENABLE_DEV_CREATE=
