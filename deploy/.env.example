# deploy/.env.example — 拷贝为 .env 后填写；.env 不入库
# 对外源（决定 joinUrl 与回跳域名）
PUBLIC_ORIGIN=https://hrack.example

# 中继服务凭证（≥32 字节随机，web 与 relay 同值）：openssl rand -hex 32
RELAY_SERVICE_TOKEN=

# Web 会话签名（openssl rand -hex 32）
BETTER_AUTH_SECRET=

# revokeToken 落盘加密密钥（32 字节 base64）
PAIRING_ENC_KEY=

# —— 以下可选 ——
# GitHub / Google OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮件（resend|smtp；未配置时验证邮件打印到 web 容器日志）
MAIL_PROVIDER=
# 中继生成页匿名创建调试开关（生产留空）
ENABLE_DEV_CREATE=
