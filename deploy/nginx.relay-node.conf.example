# Include these server blocks on a regional Relay host. Replace domains,
# certificate paths and CONTROL_CENTER_IP before enabling the file.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name relay-cn.hrack.dev dsh-cn.hrack.dev;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name relay-cn.hrack.dev;
    ssl_certificate /etc/letsencrypt/live/relay-cn.hrack.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay-cn.hrack.dev/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /remote/v1/system {
        access_log off;
        allow CONTROL_CENTER_IP;
        deny all;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location ^~ /remote/v1/system/ {
        access_log off;
        allow CONTROL_CENTER_IP;
        deny all;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location /remote/ {
        access_log off;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name dsh-cn.hrack.dev;
    ssl_certificate /etc/letsencrypt/live/relay-cn.hrack.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay-cn.hrack.dev/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
