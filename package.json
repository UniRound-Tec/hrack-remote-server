{
  "name": "hrack-remote-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "pree2e": "npm run build",
    "e2e": "playwright test",
    "preverify:live": "npm run build",
    "verify:live": "tsx scripts/live-verify.ts",
    "verify:deployed": "node scripts/deployed-verify.mjs",
    "verify:tls": "tsx scripts/tls-live-verify.ts",
    "load:gate": "tsx scripts/load-gate.ts"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.19.6",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  }
}
